         RowBox[{"c1", " ", "z1"}], "+", 
         RowBox[{"c2", " ", "z2"}]}], ")"}], "**", "w"}]}]},
    {
     RowBox[{"1", "-", 
      RowBox[{"w", "**", 
       RowBox[{"(", 
        RowBox[{"c0", "+", 
         RowBox[{"c1", " ", "z1"}], "+", 
         RowBox[{"c2", " ", "z2"}]}], ")"}]}]}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}}],
  ColumnForm[{$CellContext`c0 + $CellContext`c1 $CellContext`z1 + \
$CellContext`c2 $CellContext`z2 - 
    NonCommutativeMultiply[$CellContext`z1, $CellContext`w, $CellContext`z1], \
$CellContext`c0 + $CellContext`c1 $CellContext`z1 + $CellContext`c2 \
$CellContext`z2 - 
    NonCommutativeMultiply[$CellContext`z2, $CellContext`w, $CellContext`z2], 
    1 - NonCommutativeMultiply[$CellContext`c0 + $CellContext`c1 \
$CellContext`z1 + $CellContext`c2 $CellContext`z2, $CellContext`w], 1 - 
    NonCommutativeMultiply[$CellContext`w, $CellContext`c0 + $CellContext`c1 \
$CellContext`z1 + $CellContext`c2 $CellContext`z2]}],
