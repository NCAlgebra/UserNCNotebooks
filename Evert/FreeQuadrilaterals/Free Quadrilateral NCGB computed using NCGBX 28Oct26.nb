Cell["\<\
We will show that the polynomials in z1,z2 in GeneralGB1 above together with \
the invertibility relations generate the same ideal as GeneralGB1. I.e. if \
the polynomials in z1,z2 evaluate to zero, then all the rational functions in \
z1,z2,w evaluate to zero. To accomplish this we form a Grobner basis from \
these polynomials in z1,z2 together with the invertibility relations \
1-(c0+c1*z1+c2*z2)**w,1-w**(c0+c1*z1+c2*z2) use it to reduce GeneralGB1\
\>", "Text",
 CellChangeTimes->{
  4.0022792974210243`*^9, 4.002279876163414*^9, {4.00227995241334*^9, 
   4.0022799539394913`*^9}},ExpressionUUID->"5dd0d807-e776-4006-8835-\
71ac11c9bda1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GBpolys", "=", 
  RowBox[{"RuleToPoly", "[", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"GeneralGB1", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "4"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c0", "+", 
           RowBox[{"c1", "*", "z1"}], "+", 
           RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"w", "**", 
         RowBox[{"(", 
          RowBox[{"c0", "+", 
           RowBox[{"c1", "*", "z1"}], "+", 
           RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PolysGB", "=", 
   RowBox[{"NCMakeGB", "[", 
    RowBox[{"GBpolys", ",", "8"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.986656139030239*^9, {4.0022772041383743`*^9, 4.002277219263711*^9}, {
   4.002277306046034*^9, 4.002277307994459*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"e63b8ed9-7aab-834c-8619-5250e164b2bb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "-", 
    RowBox[{"w", "**", 
     RowBox[{"(", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "z1"}], "+", 
       RowBox[{"c2", " ", "z2"}]}], ")"}]}]}], ",", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "z1"}], "+", 
       RowBox[{"c2", " ", "z2"}]}], ")"}], "**", "w"}]}], ",", 
   RowBox[{
    SuperscriptBox["z2", "3"], "-", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "c0"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c0", " ", 
          RowBox[{"(", 
           RowBox[{"c0", "+", 
            RowBox[{"c1", " ", "z1"}]}], ")"}]}], "+", 
