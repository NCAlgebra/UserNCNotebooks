Cell[CellGroupData[{

Cell["\<\
As subcases of c1 = 0, we also consider the case where c2^2 = 1, i.e., c2 = 1 \
or -1. We first consider c2 = 1. \
\>", "Subsection",
 CellChangeTimes->{{4.002277383501449*^9, 
  4.002277428508052*^9}},ExpressionUUID->"b20c2415-0e0f-4e59-b7ff-\
0476c6d1f272"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"InvPolys", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"w", "**", 
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}], "//.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c1", "\[Rule]", " ", "0"}], ",", 
      RowBox[{"c2", "\[Rule]", " ", "1"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetMonomialOrder", "[", 
  RowBox[{"z1", ",", "z2", ",", "w"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InvGB", "=", 
   RowBox[{"NCMakeGB", "[", 
    RowBox[{"InvPolys", ",", "4"}], "]"}]}], ";"}]}], "Input",
