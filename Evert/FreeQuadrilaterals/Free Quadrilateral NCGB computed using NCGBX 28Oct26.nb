Cell[CellGroupData[{

Cell["Special cases", "Chapter",
 CellChangeTimes->{{3.7978605234114017`*^9, 
  3.79786054202785*^9}},ExpressionUUID->"f210f623-1b25-2c42-b6c1-\
3cb8a694efe3"],

Cell[TextData[{
 "We now consider several special cases of c0, c1, and c2 in the equations \
defining InvGB are not defined. Namely we consider the cases c1=0 and c2=0 \
and c1=c2=0 and",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"1", "+", 
    SuperscriptBox["c1", "2"], "-", 
    SuperscriptBox["c2", "2"]}]}]],
  CellChangeTimes->{{3.7978614281690392`*^9, 3.797861440669353*^9}, {
   3.797861502107445*^9, 3.7978615320335636`*^9}},ExpressionUUID->
  "3f404fe4-766a-b144-bdb2-3f5ae47d9ae1"],
 "=0. As described in the main article, the c0=0 cannot occur, so we do not \
consider it here. "
}], "Text",
 CellChangeTimes->{{3.797860563860584*^9, 3.797860621964425*^9}, {
   3.7978606747553988`*^9, 3.797860711284171*^9}, {3.7978608079954815`*^9, 
   3.7978608650042744`*^9}, 3.797861513490994*^9, {3.797861567165008*^9, 
   3.7978615715476646`*^9}, {3.8068465650379515`*^9, 
   3.806846600525976*^9}},ExpressionUUID->"7b0bff67-a5e9-b24c-b6ba-\
301874701d67"],

