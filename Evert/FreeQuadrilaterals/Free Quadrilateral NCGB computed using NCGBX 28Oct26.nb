Cell[CellGroupData[{

Cell["The generic case", "Chapter",
 CellChangeTimes->{{3.68773758066934*^9, 3.6877375855649242`*^9}, 
   4.002200666262207*^9},ExpressionUUID->"fcdee724-4204-48f8-ac2b-\
dd6031f11ddd"],

Cell[CellGroupData[{

Cell["\<\
General Poly Runs. With c0,c1,c2 unspecified. Here the relations generate all \
polys. \
\>", "Section",
 CellChangeTimes->{{3.687731709202191*^9, 3.6877317117185154`*^9}, {
   3.687738220056185*^9, 3.687738234624615*^9}, {3.6879725824574437`*^9, 
   3.6879726058869686`*^9}, {3.687973020174983*^9, 3.687973023106992*^9}, 
   3.687984519907712*^9, {3.6880707270723352`*^9, 3.688070746773125*^9}, {
   3.6880725351520257`*^9, 3.688072581032081*^9}, 3.688072612831476*^9, {
   3.6882302595592012`*^9, 3.688230263903469*^9}, 3.9866568818621483`*^9, {
   3.9866572028208714`*^9, 3.9866572030095387`*^9}, {4.002279807565377*^9, 
   4.002279807874928*^9}},ExpressionUUID->"2b260743-ef6b-b540-924a-\
e332f2739126"],

Cell["\<\
We compute a GB from the rational functions defining the Arveson boundary of \
our free quadrilateral. The GB contains nine NC rational functions, four of \
which are NC polynomials in z1,z2. Note that we have encoded that w is the \
inverse of (c0+c1*z1+c2*z2) via the relations 1-(c0+c1*z1+c2*z2)**w and \
1-w**(c0+c1*z1+c2*z2).

Note: Since w = Inv[c0+c1*z1+c2*z2] functions containing w are understood to \
be rational functions.\
\>", "Text",
 CellChangeTimes->{
  4.0022793483654532`*^9},ExpressionUUID->"c2845aa6-b68d-4c64-8c24-\
caf2d27401cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Polys", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"c0", "+", 
     RowBox[{"c1", "*", "z1"}], "+", 
     RowBox[{"c2", "*", "z2"}], "-", 
     RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
    RowBox[{"c0", "+", 
     RowBox[{"c1", "*", "z1"}], "+", 
     RowBox[{"c2", "*", "z2"}], "-", 
     RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"c0", "+", 
        RowBox[{"c1", "*", "z1"}], "+", 
        RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
    RowBox[{"1", "-", 
     RowBox[{"w", "**", 
      RowBox[{"(", 
       RowBox[{"c0", "+", 
        RowBox[{"c1", "*", "z1"}], "+", 
        RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.687731724098024*^9, 3.687731724529244*^9}, {
   3.68773177431537*^9, 3.687731840999401*^9}, 3.687737610501683*^9, {
   3.687972612855182*^9, 3.687972622211073*^9}, {3.687984486153305*^9, 
   3.687984492076922*^9}, {3.688061338064987*^9, 3.688061347908267*^9}, {
   3.6882302684107604`*^9, 3.688230268824976*^9}, 3.688233386245728*^9, 
   3.688233460897026*^9, 3.986656181535612*^9, {3.986656890336893*^9, 
   3.9866568932741385`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"0b3eaf32-b3f5-f944-82fd-5cb6586fe417"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"c0", "+", 
    RowBox[{"c1", " ", "z1"}], "+", 
    RowBox[{"c2", " ", "z2"}], "-", 
    RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
   RowBox[{"c0", "+", 
    RowBox[{"c1", " ", "z1"}], "+", 
    RowBox[{"c2", " ", "z2"}], "-", 
    RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "z1"}], "+", 
       RowBox[{"c2", " ", "z2"}]}], ")"}], "**", "w"}]}], ",", 
   RowBox[{"1", "-", 
    RowBox[{"w", "**", 
     RowBox[{"(", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", " ", "z1"}], "+", 
       RowBox[{"c2", " ", "z2"}]}], ")"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9866568935580034`*^9, 3.986656995025747*^9, 
  3.986657206953201*^9, 3.986658345444509*^9, 4.0022005018807983`*^9, 
