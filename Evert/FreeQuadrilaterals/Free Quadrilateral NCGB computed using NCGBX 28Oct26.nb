Cell["\<\
In this case we obtain 3 equation two of which are polynomials. Similar to \
the c1 =0 case, we use the invertibility of (c0+c1*z1) to conclude that the \
rational equation is reduced by the polynomials.\
\>", "Text",
 CellChangeTimes->{
  4.0022793929610367`*^9},ExpressionUUID->"269af501-e3cd-46db-9aca-\
65764ae1659a"],

Cell[CellGroupData[{

Cell[BoxData["InvGB"], "Input",
 CellChangeTimes->{{4.002202339286978*^9, 4.002202340246748*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"d2c5f145-8f3e-df47-82a4-1bb35bfbb674"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["z1", "2"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["c0", "2"], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["c1", "2"]}]]}], "-", 
     FractionBox[
      RowBox[{"2", " ", "c0", " ", "c1", " ", "z1"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c1", "2"]}]]}]}], ",", 
   RowBox[{
    RowBox[{"z2", "**", "z1", "**", "z2"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      SuperscriptBox["c0", "3"], 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"]}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c0", "2"], " ", "z1"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c1", "2"]}]], "-", 
     FractionBox[
      RowBox[{"c0", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["c1", "2"]}], ")"}], " ", 
       SuperscriptBox["z2", "2"]}], 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"]}], ")"}]}]]}]}], ",", 
   RowBox[{"w", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        SuperscriptBox["c1", "2"]}], "c0"]}], "+", 
     FractionBox[
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"]}], ")"}], " ", "z1"}], 
      SuperscriptBox["c0", "2"]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  4.002202340720751*^9, 4.002202376729492*^9, {4.002278623316683*^9, 
   4.0022786258308144`*^9}, 4.0022786628985276`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"7ce6a024-ebde-4f03-a3c4-6b72a3dc0706"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GBpolys", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"InvGB", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"InvGB", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]], "Input",
