Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"z1", "\[Rule]", 
    RowBox[{"-", 
     FractionBox["c0", "2"]}]}], ",", 
   RowBox[{
    SuperscriptBox["z2", "2"], "\[Rule]", 
    FractionBox[
     SuperscriptBox["c0", "2"], "4"]}], ",", 
   RowBox[{"w", "\[Rule]", 
    FractionBox["2", "c0"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002202218572199*^9, 4.0022773680290813`*^9, 
