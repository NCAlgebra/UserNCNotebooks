Cell["\<\
In this case w is a constant multiple of the identity and so all equations in \
the GB are polynomials in z1,z2.\
\>", "Text",
 CellChangeTimes->{
  4.002279364391037*^9},ExpressionUUID->"70ccdd90-d021-47d5-ae6c-\
71b85e21c345"],

