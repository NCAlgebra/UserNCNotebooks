Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["z1", "2"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["c0", "2"], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["c1", "2"]}]]}], "-", 
     FractionBox[
      RowBox[{"2", " ", "c0", " ", "c1", " ", "z1"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c1", "2"]}]]}]}], ",", 
   RowBox[{
    RowBox[{"z2", "**", "z1", "**", "z2"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      SuperscriptBox["c0", "3"], 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"]}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c0", "2"], " ", "z1"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c1", "2"]}]], "-", 
     FractionBox[
      RowBox[{"c0", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["c1", "2"]}], ")"}], " ", 
       SuperscriptBox["z2", "2"]}], 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"]}], ")"}]}]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.797861082462562*^9, 3.797861092064309*^9}, 
   3.7978612447173867`*^9, 3.806846663315521*^9, 4.002202388951826*^9, 
   4.002278625856513*^9, 4.002278662915083*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"3d9f802e-451b-4673-8ae0-4d4e7e954764"]
}, Open  ]],

Cell["\<\
Since c2 = 0, (c0+c1*z1) is the inverse of w. From this we see that the \
rational equation is reduced by the polynomials.\
\>", "Text",
 CellChangeTimes->{
  4.002279399554151*^9},ExpressionUUID->"ea772215-9e88-4c2e-98fe-\
ac9848c81d37"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"InvGB", "[", 
  RowBox[{"[", "3", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NCReplaceRepeated", "[", 
   RowBox[{
    RowBox[{"NCExpand", "[", 
     RowBox[{
      RowBox[{"RuleToPoly", "[", 
       RowBox[{"InvGB", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}], "**", 
      RowBox[{"(", 
       RowBox[{"c0", "+", 
        RowBox[{"c1", " ", "z1"}]}], ")"}]}], "]"}], ",", "GBpolys"}], "]"}], 
  "//", "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.797859929572286*^9, 3.797859931500185*^9}, {
  3.797859972781728*^9, 3.797860019675786*^9}, {3.797860065279751*^9, 
