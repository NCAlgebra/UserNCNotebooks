0c2d66609b14"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"InvPolys", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"w", "**", 
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}], "//.", 
    RowBox[{"{", 
     RowBox[{"c1", "\[Rule]", " ", "0"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetMonomialOrder", "[", 
  RowBox[{"z1", ",", "z2", ",", "w"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InvGB", "=", 
   RowBox[{"NCMakeGB", "[", 
    RowBox[{"InvPolys", ",", "4"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.797852678569206*^9, {3.7978587932764263`*^9, 3.797858806901061*^9}, {
