Cell["\<\
In this case we obtain 3 equation two of which are polynomials\
\>", "Text",
 CellChangeTimes->{
  4.002279267257084*^9},ExpressionUUID->"ac34c664-445f-4342-a8f2-\
836e6f48eee2"],

Cell[CellGroupData[{

Cell[BoxData["InvGB"], "Input",
 CellChangeTimes->{{4.0022022133132706`*^9, 4.0022022180476513`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"ed7b2d82-3cb4-b740-b6f6-b948ee449d1d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"z1", "**", "z2", "**", "z1"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      SuperscriptBox["c0", "3"], 
      RowBox[{"c2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c2", "2"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"c0", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["c2", "2"]}], ")"}], " ", 
       SuperscriptBox["z1", "2"]}], 
      RowBox[{"c2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c2", "2"]}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c0", "2"], " ", "z2"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c2", "2"]}]]}]}], ",", 
   RowBox[{
    SuperscriptBox["z2", "2"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["c0", "2"], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["c2", "2"]}]]}], "-", 
     FractionBox[
      RowBox[{"2", " ", "c0", " ", "c2", " ", "z2"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c2", "2"]}]]}]}], ",", 
   RowBox[{"w", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        SuperscriptBox["c2", "2"]}], "c0"]}], "+", 
     FractionBox[
      RowBox[{"c2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c2", "2"]}], ")"}], " ", "z2"}], 
      SuperscriptBox["c0", "2"]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002202218572199*^9, 4.0022773680290813`*^9, 
  4.0022786627562523`*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"b10df9b0-c22b-49e3-bfc2-095a8444e1cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GBpolys", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"InvGB", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"InvGB", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.797861062395658*^9, 3.797861091374119*^9}, 
   4.002202230758581*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"709ab524-4a6c-8649-a7aa-866751f0df64"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"z1", "**", "z2", "**", "z1"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      SuperscriptBox["c0", "3"], 
      RowBox[{"c2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c2", "2"]}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"c0", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["c2", "2"]}], ")"}], " ", 
       SuperscriptBox["z1", "2"]}], 
      RowBox[{"c2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c2", "2"]}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c0", "2"], " ", "z2"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c2", "2"]}]]}]}], ",", 
   RowBox[{
    SuperscriptBox["z2", "2"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["c0", "2"], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["c2", "2"]}]]}], "-", 
     FractionBox[
      RowBox[{"2", " ", "c0", " ", "c2", " ", "z2"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["c2", "2"]}]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.797861082462562*^9, 3.797861092064309*^9}, 
   3.806846663215887*^9, 4.00220215274152*^9, 4.0022022311600018`*^9, 
   4.002277368040145*^9, 4.002278662763906*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"349c27f4-0855-408a-8a39-20c07cbe2007"]
}, Open  ]],

Cell["\<\
Since c1 = 0, (c0+c2*z2) is the inverse of w. From this we see that the \
rational equation is reduced by the polynomials. In particular, (c0 +c2 z2) \
is the inverse of w and after reducing by the polynomials \
RuleToPoly[InvGB[[3]]]**(c0+c2 z2) = -1+c0 w+c2 w**z2 = -1 + w**(c0 + c2 z2) \
= 0. Thus RuleToPoly[InvGB[[3]]]**(c0+c2 z2) is in the ideal. Using \
invertibility of c0+c2 z2 gives that RuleToPoly[InvGB[[3]]] is also in the \
ideal. \
\>", "Text",
 CellChangeTimes->{{4.0022792032565413`*^9, 4.0022792092500534`*^9}, {
  4.0022794641361885`*^9, 4.002279468225127*^9}, {4.0022798263682733`*^9, 
