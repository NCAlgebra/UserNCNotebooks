Notebook[{

Cell[CellGroupData[{
Cell["\<\
NC Grobner basis computation of NC polynomials annihilating the Arveson \
boundary of a free quadrilateral using NCGBX.

This version corrects an error in a GB reduction in the 1Sep20 version. \
Additionally, this version directly adjoins the inverse relations using the \
variable w rather than inv[c0+c1*z1+c2*z2]. The latter is not supported by \
NCAlgebra 6.0.3. \
\>", "Chapter",
 CellChangeTimes->{{3.8068463297413707`*^9, 3.806846389483509*^9}, {
  4.002280025643379*^9, 4.002280100466536*^9}, {4.00228014827664*^9, 
  4.0022801755294623`*^9}},ExpressionUUID->"f0aa404c-40c8-874a-bc8c-\
73800851400c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"<<", "NC`"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "NCAlgebra`"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "NCGBX`"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RuleToPoly", "[", "rule_", "]"}], ":=", 
   RowBox[{"NCReplaceRepeated", "[", 
    RowBox[{"rule", ",", 
     RowBox[{"Rule", "\[Rule]", " ", "Subtract"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"view", "[", "list_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Substitute", "[", 
    RowBox[{"list", ",", 
     RowBox[{"NonCommutativeMultiply", "\[Rule]", " ", "Dot"}]}], "]"}], "//",
    "MatrixForm"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NCReplaceRepeatedRepeated", "[", 
    RowBox[{"polys_", ",", "ruls_", ",", "iters_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"iter", ",", "polysR"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"polysR", "=", "polys"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"iter", "=", "0"}], ",", 
        RowBox[{"iter", "<", "iters"}], ",", 
        RowBox[{"iter", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"polysR", "=", 
         RowBox[{"NCE", "[", 
          RowBox[{"NCReplaceRepeated", "[", 
           RowBox[{"polysR", ",", "ruls"}], "]"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "polysR", "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"SNC", "[", 
  RowBox[{"w", ",", "h", ",", "z1", ",", "z2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"SetMonomialOrder", "[", 
  RowBox[{"z1", ",", "z2", ",", "w", ",", "h"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"c0", ",", "c1", ",", "c2"}], "]"}]}], "Input",
 CellChangeTimes->{{3.6877381966641755`*^9, 3.687738196818414*^9}, {
  3.687959176174475*^9, 3.687959176381293*^9}, {3.688079286509354*^9, 
  3.688079289552949*^9}, {3.68808305762549*^9, 3.688083057815587*^9}, {
  3.688351913154649*^9, 3.688351914151183*^9}, {3.986655364996341*^9, 
