         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["c1", "2"], "-", 
            RowBox[{"3", " ", 
             SuperscriptBox["c2", "2"]}]}], ")"}], " ", 
          SuperscriptBox["z2", "2"]}], "+", 
         RowBox[{"c1", " ", "c2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"z1", "**", "z2"}], "+", 
            RowBox[{"z2", "**", "z1"}]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"], "-", 
         SuperscriptBox["c2", "2"]}], ")"}], " ", 
       RowBox[{"z2", "**", "z1", "**", "z2"}]}]}], 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}], ")"}], " ", "c2"}], ")"}]}], "+", 
      SuperscriptBox["c2", "3"]}]]}], ",", 
   RowBox[{
    RowBox[{"z1", "**", 
     SuperscriptBox["z2", "2"]}], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"c0", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "c2"}], " ", "z1", " ", 
          RowBox[{"(", 
