Cell["\<\
In this case w is a constant multiple of the identity and so all equations in \
the GB are polynomials in z1,z2.\
\>", "Text",
 CellChangeTimes->{
  4.002279364391037*^9},ExpressionUUID->"62950778-a562-4514-8905-\
b03f0f0229ca"],

Cell[CellGroupData[{

Cell[BoxData["InvGB"], "Input",
 CellChangeTimes->{{4.0022022133132706`*^9, 4.0022022180476513`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"74d115ca-f4d9-45bd-8826-784e8c83356c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"z1", "\[Rule]", 
    FractionBox["c0", "2"]}], ",", 
   RowBox[{
    SuperscriptBox["z2", "2"], "\[Rule]", 
    FractionBox[
     SuperscriptBox["c0", "2"], "4"]}], ",", 
   RowBox[{"w", "\[Rule]", 
    FractionBox["2", "c0"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002202218572199*^9, 4.0022773680290813`*^9, 
  4.002277442945528*^9, 4.002277546565873*^9, 4.002277643234913*^9, 
  4.0022786259892745`*^9, 4.0022786629904847`*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"ff71a60a-56d8-4b5f-a1df-23774c9af5d2"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["c1 = c2 = 0", "Section",
 CellChangeTimes->{{3.797859131415089*^9, 3.7978591975161004`*^9}, {
   3.797859384308609*^9, 3.797859396475907*^9}, {3.797860551076911*^9, 
   3.797860556819771*^9}, {3.797860721348923*^9, 3.7978607226913767`*^9}, 
   3.797860844164728*^9, 3.797861188892509*^9, {3.79786126523621*^9, 
   3.7978612657562656`*^9}, 
   3.797861595600648*^9},ExpressionUUID->"6e55b8ee-cec2-124c-bbcb-\
a6599d7e88e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"InvPolys", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"w", "**", 
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}], "//.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c1", "\[Rule]", " ", "0"}], ",", 
      RowBox[{"c2", "->", "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"InvPolys", "//", "ColumnForm"}]}], "Input",
 CellChangeTimes->{
  3.797852678569206*^9, {3.7978587932764263`*^9, 3.797858806901061*^9}, {
   3.797860735909947*^9, 3.7978607774920483`*^9}, 3.7978608681833773`*^9, {
   3.7978610013492413`*^9, 3.797861005419486*^9}, {3.7978612102052813`*^9, 
   3.797861213604109*^9}, {3.797861269893866*^9, 3.797861281755254*^9}, 
   3.797861783491055*^9, {4.0022024583385506`*^9, 4.0022024643592434`*^9}, {
   4.0022025312678604`*^9, 4.0022025503690243`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"599df8e3-35d3-bb48-97f9-c192b1e1faa2"],

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     RowBox[{"c0", "-", 
      RowBox[{"z1", "**", "w", "**", "z1"}]}]},
    {
     RowBox[{"c0", "-", 
      RowBox[{"z2", "**", "w", "**", "z2"}]}]},
    {
     RowBox[{"1", "-", 
      RowBox[{"c0", " ", "w"}]}]},
    {
     RowBox[{"1", "-", 
      RowBox[{"c0", " ", "w"}]}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}}],
  ColumnForm[{$CellContext`c0 - 
    NonCommutativeMultiply[$CellContext`z1, $CellContext`w, $CellContext`z1], \
$CellContext`c0 - 
    NonCommutativeMultiply[$CellContext`z2, $CellContext`w, $CellContext`z2], 
    1 - $CellContext`c0 $CellContext`w, 1 - $CellContext`c0 $CellContext`w}],
  Editable->False]], "Output",
 CellChangeTimes->{4.0022025507382145`*^9, 4.0022776465059175`*^9, 
  4.002278662997652*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"497fe79e-78e9-47db-8679-91786b2c8ff4"]
}, Open  ]],

Cell["\<\
In this case 1-c0 w = 0 and so w is a constant multiple of the identity. Thus \
all functions are polynomials in z1 and z2.\
\>", "Text",
 CellChangeTimes->{
  4.002279419161048*^9},ExpressionUUID->"f7bd5ba1-46d8-4b46-9098-\
732ed2530ebd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{"1", "+", 
    SuperscriptBox["c1", "2"], "-", 
    SuperscriptBox["c2", "2"]}]}]],
  CellChangeTimes->{{3.7978614281690392`*^9, 3.797861440669353*^9}, {
   3.797861502107445*^9, 3.7978615320335636`*^9}},ExpressionUUID->
  "a0626e2f-dfbf-a24c-b80f-876c070a57ca"],
 "= 0 and c1 \[NotEqual]  0. "
}], "Section",
 CellChangeTimes->{{3.797859131415089*^9, 3.7978591975161004`*^9}, {
