 CellLabel->"In[38]:=",ExpressionUUID->"cac7305c-ce88-4427-b47b-dfdad7cf2ebf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["z1", "2"], "\[Rule]", 
    FractionBox[
     SuperscriptBox["c0", "2"], "4"]}], ",", 
   RowBox[{"z2", "\[Rule]", 
    RowBox[{"-", 
     FractionBox["c0", "2"]}]}], ",", 
   RowBox[{"w", "\[Rule]", 
    FractionBox["2", "c0"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.002202218572199*^9, 4.0022773680290813`*^9, 
  4.002277442945528*^9, 4.0022786628164406`*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"07a11d02-ca11-4a2e-84c6-a777a5156bcb"]
}, Open  ]]
}, Open  ]],

