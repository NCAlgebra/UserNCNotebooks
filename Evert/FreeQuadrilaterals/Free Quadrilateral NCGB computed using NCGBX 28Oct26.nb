  3.797861747251494*^9}},ExpressionUUID->"99f0b2f6-719d-cd40-a8da-\
71c40d9a7ace"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 RowBox[{"c2", "=", 
  RowBox[{"-", 
   SqrtBox[
    RowBox[{"1", "+", 
     SuperscriptBox["c1", "2"]}]]}]}]],
 CellChangeTimes->{
  3.797861466848364*^9},ExpressionUUID->"9c115ddd-72c4-8140-9ece-\
f597a92764b8"]], "Subsection",
