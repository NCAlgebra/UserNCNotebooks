Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"InvGB", "[", 
  RowBox[{"[", "3", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NCReplaceRepeated", "[", 
   RowBox[{
    RowBox[{"NCExpand", "[", 
     RowBox[{
      RowBox[{"RuleToPoly", "[", 
       RowBox[{"InvGB", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}], "**", 
      RowBox[{"(", 
       RowBox[{"c0", "+", 
        RowBox[{"c2", " ", "z2"}]}], ")"}]}], "]"}], ",", "GBpolys"}], "]"}], 
  "//", "FullSimplify"}]}], "Input",
