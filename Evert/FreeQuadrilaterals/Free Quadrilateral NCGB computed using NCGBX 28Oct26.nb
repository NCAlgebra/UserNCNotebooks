Cell["We have two polynomials in z1,z2", "Text",
 CellChangeTimes->{
  4.0022794269010515`*^9},ExpressionUUID->"f1df55b0-0a5d-4a30-9c40-\
cba9407fc5e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InvGB", "//", "ColumnForm"}]], "Input",
 CellChangeTimes->{{4.0022026510032825`*^9, 4.002202655396492*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"87a49e5c-f463-e846-af03-079315e4007e"],

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     RowBox[{
      RowBox[{"z2", "**", "z1"}], "\[Rule]", 
      RowBox[{
       FractionBox[
        SuperscriptBox["c0", "2"], 
        RowBox[{"c1", " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]}]], "+", 
       FractionBox[
        RowBox[{"3", " ", "c0", " ", "z1"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["c1", "2"]}], ")"}], " ", 
         SuperscriptBox["z1", "2"]}], 
        RowBox[{"c1", " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]}]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["z1", "3"]}], 
        RowBox[{"c0", " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]}]], "-", 
       FractionBox[
        RowBox[{"c0", " ", "z2"}], "c1"], "-", 
       RowBox[{"z1", "**", "z2"}]}]}]},
    {
     RowBox[{
      SuperscriptBox["z2", "2"], "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"3", " ", "c0", " ", "c1"}], 
           RowBox[{"1", "+", 
            SuperscriptBox["c1", "2"]}]], "-", 
          FractionBox[
           RowBox[{
            RowBox[{"-", "c0"}], "+", 
            RowBox[{"2", " ", "c0", " ", 
             SuperscriptBox["c1", "2"]}]}], 
           RowBox[{"c1", " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SuperscriptBox["c1", "2"]}], ")"}]}]]}], ")"}], " ", "z1"}], 
       "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{
             RowBox[{"-", "3"}], "+", 
             SuperscriptBox["c1", "2"]}], 
            RowBox[{"1", "+", 
             SuperscriptBox["c1", "2"]}]]}], "+", 
          FractionBox[
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox["c1", "2"]}], ")"}]}], 
           RowBox[{"1", "+", 
            SuperscriptBox["c1", "2"]}]]}], ")"}], " ", 
        SuperscriptBox["z1", "2"]}], "+", 
       FractionBox[
        RowBox[{"c0", " ", "z2"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["c1", 
            SqrtBox[
             RowBox[{"1", "+", 
              SuperscriptBox["c1", "2"]}]]]}], "-", 
          FractionBox[
           RowBox[{"2", "-", 
            SuperscriptBox["c1", "2"]}], 
           RowBox[{"c1", " ", 
            SqrtBox[
             RowBox[{"1", "+", 
              SuperscriptBox["c1", "2"]}]]}]]}], ")"}], " ", 
        RowBox[{"z1", "**", "z2"}]}], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{
          SuperscriptBox["z1", "2"], "**", "z2"}]}], 
        RowBox[{"c0", " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]}]]}]}]},
    {
     RowBox[{
      RowBox[{"w", "**", "z1"}], "\[Rule]", 
      RowBox[{
       FractionBox["2", "c1"], "-", 
       FractionBox[
        RowBox[{"c0", " ", "w"}], "c1"], "+", 
       FractionBox[
        RowBox[{"2", " ", "z1"}], "c0"], "-", 
       RowBox[{"z1", "**", "w"}]}]}]},
    {
     RowBox[{
      RowBox[{
       SuperscriptBox["z1", "2"], "**", "w"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", "c0"}], "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           SuperscriptBox["c1", "2"]}], ")"}], " ", "z1"}], "c1"], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["z1", "2"]}], "c0"], "+", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]], " ", "z2"}], "-", 
       FractionBox[
        RowBox[{"c0", " ", 
         RowBox[{"z1", "**", "w"}]}], "c1"]}]}]},
    {
     RowBox[{
      RowBox[{"z2", "**", "w"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]]}], "+", 
       FractionBox[
        RowBox[{"c0", " ", "w"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]], "+", 
       FractionBox[
        RowBox[{"c1", " ", 
         RowBox[{"z1", "**", "w"}]}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]]}]}]},
    {
     RowBox[{
      RowBox[{"w", "**", "z2"}], "\[Rule]", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]], "+", 
       FractionBox[
        RowBox[{"2", " ", "c1", " ", "z1"}], 
        RowBox[{"c0", " ", 
         SqrtBox[
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}]]}]], "-", 
       FractionBox[
        RowBox[{"c1", " ", 
         RowBox[{"z1", "**", "w"}]}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox["c1", "2"]}]]]}]}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}}],
  ColumnForm[{
   NonCommutativeMultiply[$CellContext`z2, $CellContext`z1] -> \
$CellContext`c0^2 $CellContext`c1^(-1) (1 + $CellContext`c1^2)^
       Rational[-1, 2] + 
     3 $CellContext`c0 (1 + $CellContext`c1^2)^
       Rational[-1, 2] $CellContext`z1 + 
     2 $CellContext`c1^(-1) (-1 + $CellContext`c1^2) (1 + $CellContext`c1^2)^
       Rational[-1, 2] $CellContext`z1^2 - 
     2 $CellContext`c0^(-1) (1 + $CellContext`c1^2)^
      Rational[-1, 
        2] $CellContext`z1^3 - $CellContext`c0 $CellContext`c1^(-1) \
$CellContext`z2 - 
     NonCommutativeMultiply[$CellContext`z1, $CellContext`z2], \
$CellContext`z2^2 -> (
       3 $CellContext`c0 $CellContext`c1/(
        1 + $CellContext`c1^2) - $CellContext`c1^(-1) (
         1 + $CellContext`c1^2)^(-1) (-$CellContext`c0 + 
        2 $CellContext`c0 $CellContext`c1^2)) $CellContext`z1 + (-(-3 + \
$CellContext`c1^2)/(1 + $CellContext`c1^2) + 
       2 (-1 + $CellContext`c1^2)/(
        1 + $CellContext`c1^2)) $CellContext`z1^2 + $CellContext`c0 (
        1 + $CellContext`c1^2)^
       Rational[-1, 
         2] $CellContext`z2 + (-$CellContext`c1 (1 + $CellContext`c1^2)^
         Rational[-1, 2] - $CellContext`c1^(-1) (
        2 - $CellContext`c1^2) (1 + $CellContext`c1^2)^Rational[-1, 2]) 
      NonCommutativeMultiply[$CellContext`z1, $CellContext`z2] - 
     2 $CellContext`c0^(-1) (1 + $CellContext`c1^2)^Rational[-1, 2] 
     NonCommutativeMultiply[$CellContext`z1^2, $CellContext`z2], 
    NonCommutativeMultiply[$CellContext`w, $CellContext`z1] -> 
    2/$CellContext`c1 - $CellContext`c0 $CellContext`c1^(-1) $CellContext`w + 
     2 $CellContext`c0^(-1) $CellContext`z1 - 
     NonCommutativeMultiply[$CellContext`z1, $CellContext`w], 
    NonCommutativeMultiply[$CellContext`z1^2, $CellContext`w] -> \
-$CellContext`c0 - $CellContext`c1^(-1) (-2 + $CellContext`c1^2) \
$CellContext`z1 + 
     2 $CellContext`c0^(-1) $CellContext`z1^2 + (1 + $CellContext`c1^2)^
       Rational[1, 2] $CellContext`z2 - $CellContext`c0 $CellContext`c1^(-1) 
     NonCommutativeMultiply[$CellContext`z1, $CellContext`w], 
    NonCommutativeMultiply[$CellContext`z2, $CellContext`w] -> -(
        1 + $CellContext`c1^2)^
       Rational[-1, 2] + $CellContext`c0 (1 + $CellContext`c1^2)^
       Rational[-1, 2] $CellContext`w + $CellContext`c1 (
        1 + $CellContext`c1^2)^Rational[-1, 2] 
      NonCommutativeMultiply[$CellContext`z1, $CellContext`w], 
    NonCommutativeMultiply[$CellContext`w, $CellContext`z2] -> (
       1 + $CellContext`c1^2)^Rational[-1, 2] + 
     2 $CellContext`c0^(-1) $CellContext`c1 (1 + $CellContext`c1^2)^
       Rational[-1, 2] $CellContext`z1 - $CellContext`c1 (
       1 + $CellContext`c1^2)^Rational[-1, 2] 
     NonCommutativeMultiply[$CellContext`z1, $CellContext`w]}],
  Editable->False]], "Output",
 CellChangeTimes->{4.0022026558493824`*^9, 4.002202770412895*^9, 
  4.002277657043513*^9, 4.0022786631707087`*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"87984798-996d-40b7-9774-0f4ed73a2db9"]
}, Open  ]],

Cell["\<\
As in the generic case we form a Grobner basis using the polynomials in z1 \
and z2 together with the inverse relations reduces the remaining rational \
equations.\
\>", "Text",
 CellChangeTimes->{{4.0022794345044527`*^9, 
  4.002279435396061*^9}},ExpressionUUID->"0cd21921-5a84-40b1-802f-\
047a9aea303f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GBpolys", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"InvGB", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"c0", "+", 
            RowBox[{"c1", "*", "z1"}], "+", 
            RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
        RowBox[{"1", "-", 
         RowBox[{"w", "**", 
          RowBox[{"(", 
           RowBox[{"c0", "+", 
            RowBox[{"c1", "*", "z1"}], "+", 
            RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}]}], "]"}], "//.", 
    RowBox[{"{", 
     RowBox[{"c2", "\[Rule]", " ", 
      RowBox[{"-", 
       SqrtBox[
        RowBox[{"1", "+", 
         SuperscriptBox["c1", "2"]}]]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PolysGB", "=", 
   RowBox[{"NCMakeGB", "[", 
    RowBox[{"GBpolys", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InvPolys", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"RuleToPoly", ",", "InvGB"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"InvGBSimplified", "=", 
  RowBox[{
   RowBox[{"NCReplaceRepeated", "[", 
    RowBox[{"InvPolys", ",", "PolysGB"}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.7978614241343393`*^9, 3.797861440397207*^9}, {
   3.797861494238239*^9, 3.797861531670062*^9}, {3.7978618982377*^9, 
