Cell[BoxData[{
 RowBox[{
  RowBox[{"InvPolys", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z1", "**", "w", "**", "z1"}]}], ",", 
      RowBox[{"c0", "+", 
       RowBox[{"c1", "*", "z1"}], "+", 
       RowBox[{"c2", "*", "z2"}], "-", 
       RowBox[{"z2", "**", "w", "**", "z2"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}], "**", "w"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"w", "**", 
        RowBox[{"(", 
         RowBox[{"c0", "+", 
          RowBox[{"c1", "*", "z1"}], "+", 
          RowBox[{"c2", "*", "z2"}]}], ")"}]}]}]}], "}"}], "//.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c2", "\[Rule]", " ", "0"}], ",", 
      RowBox[{"c1", "\[Rule]", " ", 
       RowBox[{"-", "1"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetMonomialOrder", "[", 
  RowBox[{"z1", ",", "z2", ",", "w"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InvGB", "=", 
   RowBox[{"NCMakeGB", "[", 
    RowBox[{"InvPolys", ",", "4"}], "]"}]}], ";"}]}], "Input",
