            RowBox[{"c1", " ", "z1"}]}], ")"}]}], "+", 
         RowBox[{"c0", " ", "c1", " ", "z2"}], "+", 
         RowBox[{"c1", " ", "c2", " ", 
          SuperscriptBox["z2", "2"]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"c1", "-", "c2"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"c1", "+", "c2"}], ")"}], " ", 
          RowBox[{"z1", "**", "z2"}]}]}], ")"}]}], "+", 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["c1", "2"], "-", 
         SuperscriptBox["c2", "2"]}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["z1", "2"], "**", "z2"}]}]}], 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["c1", "2"]}], ")"}], " ", "c2"}], ")"}]}], "+", 
      SuperscriptBox["c2", "3"]}]]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"c0", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "c2"}], " ", "z1", " ", 
           RowBox[{"(", 
            RowBox[{"c0", "+", 
             RowBox[{"c1", " ", "z1"}]}], ")"}]}], "+", 
          RowBox[{"c0", " ", "c1", " ", "z2"}], "+", 
          RowBox[{"c1", " ", "c2", " ", 
           SuperscriptBox["z2", "2"]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"c1", "-", "c2"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"c1", "+", "c2"}], ")"}], " ", 
           RowBox[{"z2", "**", "z1"}]}]}], ")"}]}], "+", 
       RowBox[{"c1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["c1", "2"], "-", 
          SuperscriptBox["c2", "2"]}], ")"}], " ", 
        RowBox[{"z2", "**", 
         SuperscriptBox["z1", "2"]}]}]}], 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["c1", "2"]}], ")"}], " ", "c2"}], ")"}]}], "+", 
       SuperscriptBox["c2", "3"]}]]}], "+", 
    RowBox[{
     SuperscriptBox["z2", "2"], "**", "z1"}]}], ",", 
   RowBox[{
