Cell[CellGroupData[{

Cell[TextData[StyleBox["Remark 6.6 Example of separable cpp product with left \
and right identity. ", "Chapter"]], "Chapter",
 CellChangeTimes->{{3.9918313553559284`*^9, 
  3.991831363265825*^9}},ExpressionUUID->"eabbc2b0-1976-4b4d-9279-\
ed619dc9ec30"],

Cell["\<\
The following is used to initialize the product. The product Phi(A,B) is \
defined by its Choi-Kraus representation \\sum Ui^* (A \\otimes B) Ui\
\>", "Text",
 CellChangeTimes->{{3.991830587812756*^9, 3.99183062086552*^9}, {
  3.99183090997841*^9, 
  3.9918309140674057`*^9}},ExpressionUUID->"f78020b9-2527-49d6-a5e1-\
0ba0cc393ca9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ProdId", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vList", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "-", "I"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WList", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], "/", "4"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "/", "4"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "/", "4"}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "/", "4"}]}], "}"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"I", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colVec", "[", "M_", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Transpose", "[", "M", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wList", "=", 
   RowBox[{"colVec", "/@", "WList"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeU", "[", 
    RowBox[{"v_", ",", "w_"}], "]"}], ":=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", "w", ",", "v"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UList", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{"makeU", ",", 
     RowBox[{"{", 
      RowBox[{"vList", ",", "wList"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SepPhi", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"UList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"A", ",", "B"}], "]"}], ".", 
       RowBox[{"UList", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.989943448474729*^9, 3.989943448474729*^9}, {
  3.990022195910071*^9, 3.990022196411336*^9}, {3.9918302861215825`*^9, 
  3.991830303110999*^9}, {3.991830416964885*^9, 3.9918304448967133`*^9}, {
  3.991830562391284*^9, 3.991830582803761*^9}, {3.9918306278619213`*^9, 
  3.9918306428226976`*^9}, {3.9918373568300915`*^9, 3.991837357126294*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"f80e656e-7d1c-4b7f-a7d6-f7a5721b8382"],

Cell["\<\
Here we check that ProdId is a left and right identity of the product. Here \
A2 is an arbitrary 2 x 2 matrix. \
\>", "Text",
 CellChangeTimes->{{3.99183062604105*^9, 3.9918306516226883`*^9}, {
  3.991830695460142*^9, 
  3.9918307078146305`*^9}},ExpressionUUID->"09189bf2-950e-4ca4-be04-\
a3d3b56e1529"],

