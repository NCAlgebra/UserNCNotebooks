 RowBox[{"A2", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"SepPhi", "[", 
    RowBox[{"ProdId", ",", "A2"}], "]"}], "]"}], "==", "A2"}], "\n", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"SepPhi", "[", 
    RowBox[{"A2", ",", "ProdId"}], "]"}], "]"}], "==", "A2"}]}], "Input",
