Cell["\<\
We now confirm that Vprod(Vprod(A,B),C) = Vprod(A,Vprod(B,C)). Here we use \
the fact that t is real, so Conjugate[t]=t. \
\>", "Text",
 CellChangeTimes->{{3.991831828073922*^9, 3.991831849948737*^9}, {
  3.991831881230364*^9, 
  3.991831897438345*^9}},ExpressionUUID->"393b04da-63fe-41d8-a091-\
db6b74e5cc20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"Vprod", "[", 
    RowBox[{
     RowBox[{"Vprod", "[", 
      RowBox[{"A3", ",", "B3"}], "]"}], ",", "C3"}], "]"}], "]"}], "-", 
  RowBox[{"Vprod", "[", 
   RowBox[{"A3", ",", 
    RowBox[{"Vprod", "[", 
     RowBox[{"B3", ",", "C3"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{"t", ",", "Reals"}], "]"}], ",", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Vprod", "[", 
      RowBox[{
       RowBox[{"Vprod", "[", 
        RowBox[{"A3", ",", "B3"}], "]"}], ",", "C3"}], "]"}], "]"}]}], "]"}], 
  "==", 
  RowBox[{"Vprod", "[", 
   RowBox[{"A3", ",", 
    RowBox[{"Vprod", "[", 
     RowBox[{"B3", ",", "C3"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9918318656653795`*^9, 3.991831877202383*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"762a259f-9b19-4823-9a4a-b97a4bb9823b"],

