   RowBox[{
    RowBox[{"ProdAmp", "[", 
     RowBox[{"SepPhi", ",", "Choi2", ",", "Choi2", ",", "2"}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SepPhiChoi", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"PositiveSemidefiniteMatrixQ", "[", "SepPhiChoi", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"SepPhiChoi", "//", "Eigenvalues"}]}], "Input",
