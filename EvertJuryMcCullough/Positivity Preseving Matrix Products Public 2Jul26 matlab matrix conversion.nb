    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.991739869894348*^9, 3.9917399698385735`*^9, 
  3.9918315312816086`*^9, 3.991831735844977*^9, 3.9918374860183764`*^9, 
  3.991837532620772*^9, 3.9919182510676994`*^9, 3.9919999528272552`*^9},
 CellLabel->
  "Out[82]//MatrixForm=",ExpressionUUID->"49e625bc-4643-e644-bbab-\
844a8483fb11"]
}, Open  ]],

Cell["\<\
We define the product Vprod by Vprod(A,B) = V^* (A \\otimes B)V\
\>", "Text",
 CellChangeTimes->{{3.991831774119616*^9, 
  3.9918317896164618`*^9}},ExpressionUUID->"3957fb5b-889e-41a4-bf53-\
e50577c6ea9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Vprod", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"ConjugateTranspose", "[", "V", "]"}], ".", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"A", ",", "B"}], "]"}], ".", "V"}]}]], "Input",
 CellChangeTimes->{{3.991739574408098*^9, 3.991739583487213*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"b73a0de8-d704-4bb7-8ef1-4c4a6602793c"],

