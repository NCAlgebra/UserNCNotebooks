Cell["\<\
We now obtain an alternative Choi-Kraus representation of CommPhi using the \
approach described in Remark 5.3\
\>", "Text",
 CellChangeTimes->{{3.991833949309135*^9, 
  3.991833980876099*^9}},ExpressionUUID->"de6b0be6-0153-432c-a950-\
1eaaf0584b45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], "//", 
    "Orthogonalize"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"W", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"tp", "[", "w1", "]"}], ",", 
     RowBox[{"tp", "[", "w2", "]"}], ",", 
     RowBox[{"tp", "[", "w3", "]"}], ",", 
     RowBox[{"tp", "[", "w4", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"uw1", ",", "uw2", ",", "uw3", ",", "uw4"}], "}"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"List", "/@", "#"}], "&"}], "/@", 
     RowBox[{"Simplify", "[", 
      RowBox[{"U", ".", "W"}], "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CommPhiAltRep", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "uw1", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "uw1"}], "+", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "uw2", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "uw2"}], "+", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "uw3", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "uw3"}], "+", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "uw4", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "uw4"}]}]}]}], "Input",
 CellChangeTimes->{{3.98518971424635*^9, 3.985189741535876*^9}, {
