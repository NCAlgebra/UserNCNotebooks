        RowBox[{"1", ",", "1"}], "]"}], " ", 
       RowBox[{"c", "[", 
        RowBox[{"1", ",", "1"}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"(", 
          RowBox[{"t", "-", 
           RowBox[{"Conjugate", "[", "t", "]"}]}], ")"}]}]], " ", 
       RowBox[{"a", "[", 
