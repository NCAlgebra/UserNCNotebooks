  RowBox[{"PSDsn2N20K8", "=", 
   RowBox[{"WishartPairsN", "[", 
    RowBox[{"ns", ",", "ne", ",", "k", ",", "iters"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
