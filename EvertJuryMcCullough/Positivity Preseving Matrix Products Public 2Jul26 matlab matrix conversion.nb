Cell["\<\
We first obtain a Choi-Kraus representation of CommPhi by finding the \
eigenvectors of the Choi matrx and scaling them by the square root of the \
associated eigenvalue. \
\>", "Text",
 CellChangeTimes->{{3.991833327003809*^9, 
  3.991833359289587*^9}},ExpressionUUID->"76e5a959-f79c-4d52-8810-\
d947cbb9f9da"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lam1", ",", "lam2", ",", "lam3", ",", "lam4"}], "}"}], "=", 
   RowBox[{"Eigenvalues", "[", "CommChoi", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u1", ",", "u2", ",", "u3", ",", "u4"}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Eigenvectors", "[", "CommChoi", "]"}], "//", "Orthogonalize"}], 
    "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"w1", "=", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", "lam1", "]"}], "*", 
     RowBox[{"{", "u1", "}"}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"w2", "=", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", "lam2", "]"}], "*", 
     RowBox[{"{", "u2", "}"}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"w3", "=", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", "lam3", "]"}], "*", 
     RowBox[{"{", "u3", "}"}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"w4", "=", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", "lam4", "]"}], "*", 
     RowBox[{"{", "u4", "}"}]}], "]"}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.985189212232376*^9, 3.985189301990374*^9}, {
   3.985189382676375*^9, 3.9851894066054244`*^9}, 3.991833193838832*^9, {
