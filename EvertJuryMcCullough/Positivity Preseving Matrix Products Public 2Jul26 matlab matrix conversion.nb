Cell["\<\
Plotting Data. The first plot shows means and the second shows medians. \
\>", "Text",
 CellChangeTimes->{{3.9918381079516487`*^9, 
  3.9918381249845386`*^9}},ExpressionUUID->"0c34c97a-2fc3-4e8e-a7c8-\
