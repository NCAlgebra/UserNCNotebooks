Cell["\<\
We obtain the Following Choi-Kraus representation of CommPhi. We confirm that \
the Choi matrix obtained from this Choi-Kraus representation is equal to the \
original Choi matrix\
\>", "Text",
 CellChangeTimes->{{3.991833632806475*^9, 3.991833665233382*^9}, {
  3.991833698785402*^9, 
  3.991833746162362*^9}},ExpressionUUID->"b76914e3-2357-4907-8be5-\
2e2251bd6327"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"CommPhi", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Transpose", "[", "w1", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "w1"}], "+", 
   RowBox[{
    RowBox[{"Transpose", "[", "w2", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "w2"}], "+", 
   RowBox[{
    RowBox[{"Transpose", "[", "w3", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "w3"}], "+", 
   RowBox[{
    RowBox[{"Transpose", "[", "w4", "]"}], ".", 
    RowBox[{"kp", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ".", "w4"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CommChoiFromPhi", "=", 
   RowBox[{
    RowBox[{"ProdAmp", "[", 
     RowBox[{"CommPhi", ",", "Choi2", ",", "Choi2", ",", "2"}], "]"}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"CommChoiFromPhi", "\[Equal]", "CommChoi"}]}], "Input",
 CellChangeTimes->{{3.9918334281085725`*^9, 3.99183343076972*^9}, {
  3.991833475918644*^9, 3.991833526288588*^9}, {3.9918336231956844`*^9, 
  3.9918336283524804`*^9}, {3.9918336750244265`*^9, 3.9918336857243834`*^9}, {
  3.991833817902199*^9, 3.991833835294239*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"8734858b-cc77-449e-b140-68d165ff7706"],

