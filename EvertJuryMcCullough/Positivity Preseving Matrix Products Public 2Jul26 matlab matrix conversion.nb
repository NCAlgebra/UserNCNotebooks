   RowBox[{"SepPhi", ",", "Choi2", ",", "Choi2", ",", "2"}], "]"}], "==", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"kp", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Flatten", "[", 
          RowBox[{"WList", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], "]"}], ".", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"kp", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Flatten", "[", 
          RowBox[{"WList", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"Simplify", "[", "UList", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", 
  RowBox[{"SingularValueList", ",", 
   RowBox[{"Simplify", "[", "UList", "]"}]}], "]"}]}], "Input",
