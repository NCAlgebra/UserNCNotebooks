Cell["\<\
We verify that the bound of Theorem 3.4 achieves equality in the n=2 case and \
that it is dominated by the true determinant in all other cases. For each n \
we count the total number of cases where this holds. Since we run 1000 \
iterations for each n, we expect each of these values to be equal to 1000. \
\>", "Text",
 CellChangeTimes->{{3.991838029044484*^9, 
  3.991838093467665*^9}},ExpressionUUID->"22165c6f-f4c2-4149-8b58-\
bbac3cfeb935"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Total", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"DetBoundsK8", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "j"}], "]"}], "]"}], "-", 
         RowBox[{"DetBoundsK8", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "4", ",", "j"}], "]"}], "]"}]}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "12"}], ")"}]}]}], ",", "1", ",", "0"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "iters"}], "}"}]}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Total", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
