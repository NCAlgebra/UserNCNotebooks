       RowBox[{"DetBoundsK8", "[", 
        RowBox[{"[", 
         RowBox[{"k", ",", "4", ",", "j"}], "]"}], "]"}]}], ",", "1", ",", 
      "0"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "iters"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "2", ",", "len"}], "}"}]}], "]"}], "]"}]}], "Input",
