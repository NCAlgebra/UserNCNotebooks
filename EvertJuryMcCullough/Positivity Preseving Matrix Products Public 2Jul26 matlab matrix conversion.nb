Cell["We now confirm that (I \\otimes V) V = \\omega (V \\otimes I) V", "Text",
 CellChangeTimes->{{3.9918319196403217`*^9, 
  3.991831942805299*^9}},ExpressionUUID->"3d3dc292-2fb5-407d-9994-\
c7716d00776a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"id3", ",", "V"}], "]"}], ".", "V"}], "==", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"I", "*", "t"}], "]"}], "*", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"V", ",", "id3"}], "]"}], ".", "V"}]}]}]], "Input",
 CellChangeTimes->{{3.991739721980387*^9, 3.991739792854166*^9}, {
   3.991740014824268*^9, 3.991740016440929*^9}, 3.991831592204565*^9, {
